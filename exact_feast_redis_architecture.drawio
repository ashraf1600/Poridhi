        <mxCell id="box_server" value="&lt;table style=&quot;width:100%; height:100%; border:none;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:40px; vertical-align:middle; text-align:center;&quot;&gt;&lt;svg width=&quot;34&quot; height=&quot;34&quot; viewBox=&quot;0 0 44 44&quot; fill=&quot;none&quot; stroke=&quot;#0284C7&quot; stroke-width=&quot;2.4&quot; stroke-linecap=&quot;round&quot; stroke-linejoin=&quot;round&quot;&gt;&lt;path d=&quot;M 28 6 C 24 8 20 14 18 20 L 12 24 L 6 22 L 4 24 L 9 29 L 14 34 L 16 32 L 14 26 L 18 20 C 24 18 30 14 32 10 Z&quot; fill=&quot;#E0F2FE&quot;/&gt;&lt;circle cx=&quot;24&quot; cy=&quot;14&quot; r=&quot;2&quot; fill=&quot;#0284C7&quot;/&gt;&lt;path d=&quot;M 9 29 L 5 35 L 11 31&quot;/&gt;&lt;/svg&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:middle; text-align:left; padding-left:6px;&quot;&gt;&lt;b style=&quot;font-size:15px; color:#0F172A;&quot;&gt;Feast Server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px; color:#0284C7; font-weight:600;&quot;&gt;Feature API • Port 6566&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px; color:#475569;&quot;&gt;Receives requests,&lt;br&gt;serves features, handles&lt;br&gt;streaming writes&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E0F2FE;strokeColor=#7DD3FC;strokeWidth=1.5;align=left;spacingLeft=8;" vertex="1" parent="1">
