        <!-- Offline Feature Data -->
        <mxCell id="box_offline" value="&lt;table style=&quot;width:100%; height:100%; border:none;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:40px; vertical-align:middle; text-align:center;&quot;&gt;&lt;svg width=&quot;34&quot; height=&quot;38&quot; viewBox=&quot;0 0 44 48&quot; fill=&quot;none&quot; stroke=&quot;#6D28D9&quot; stroke-width=&quot;2.2&quot;&gt;&lt;ellipse cx=&quot;22&quot; cy=&quot;10&quot; rx=&quot;14&quot; ry=&quot;5&quot; fill=&quot;#FAF5FF&quot;/&gt;&lt;path d=&quot;M 8 10 V 20 C 8 23 14 25 22 25 C 30 25 36 23 36 20 V 10&quot;/&gt;&lt;path d=&quot;M 8 20 V 30 C 8 33 14 35 22 35 C 30 35 36 33 36 30 V 20&quot;/&gt;&lt;path d=&quot;M 8 30 V 40 C 8 43 14 45 22 45 C 30 45 36 43 36 40 V 30&quot;/&gt;&lt;/svg&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:middle; text-align:left; padding-left:6px;&quot;&gt;&lt;b style=&quot;font-size:15px; color:#0F172A;&quot;&gt;Offline Feature Data&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px; color:#7C3AED; font-weight:600;&quot;&gt;driver_stats.parquet&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10.5px; color:#475569;&quot;&gt;Historical feature values&lt;br&gt;for batch/training&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#F3E8FF;strokeColor=#D8B4FE;strokeWidth=1.5;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="385" width="185" height="120" as="geometry" />
