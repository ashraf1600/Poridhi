        <!-- Feast Web UI -->
        <mxCell id="box_ui" value="&lt;table style=&quot;width:100%; height:100%; border:none;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:40px; vertical-align:middle; text-align:center;&quot;&gt;&lt;svg width=&quot;36&quot; height=&quot;32&quot; viewBox=&quot;0 0 44 40&quot; fill=&quot;none&quot; stroke=&quot;#0284C7&quot; stroke-width=&quot;2.4&quot; stroke-linecap=&quot;round&quot; stroke-linejoin=&quot;round&quot;&gt;&lt;rect x=&quot;4&quot; y=&quot;6&quot; width=&quot;36&quot; height=&quot;24&quot; rx=&quot;3&quot; fill=&quot;#E0F2FE&quot;/&gt;&lt;line x1=&quot;22&quot; y1=&quot;30&quot; x2=&quot;22&quot; y2=&quot;36&quot;/&gt;&lt;line x1=&quot;14&quot; y1=&quot;36&quot; x2=&quot;30&quot; y2=&quot;36&quot;/&gt;&lt;/svg&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:middle; text-align:left; padding-left:8px;&quot;&gt;&lt;b style=&quot;font-size:15px; color:#0F172A;&quot;&gt;Feast Web UI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px; color:#0284C7; font-weight:600;&quot;&gt;Feature Catalog • Port 8888&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px; color:#475569;&quot;&gt;Browse and inspect features&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#E0F2FE;strokeColor=#7DD3FC;strokeWidth=1.5;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="535" width="240" height="110" as="geometry" />
