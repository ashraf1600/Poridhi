        <!-- Batch Materialization -->
        <mxCell id="box_mat" value="&lt;table style=&quot;width:100%; height:100%; border:none;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;width:40px; vertical-align:middle; text-align:center;&quot;&gt;&lt;svg width=&quot;34&quot; height=&quot;34&quot; viewBox=&quot;0 0 44 44&quot; fill=&quot;none&quot; stroke=&quot;#B45309&quot; stroke-width=&quot;2.2&quot;&gt;&lt;circle cx=&quot;22&quot; cy=&quot;22&quot; r=&quot;6&quot;/&gt;&lt;path d=&quot;M 22 6 L 24 10 L 28 10 L 29 14 L 33 15 L 33 19 L 37 21 L 36 25 L 38 29 L 35 32 L 34 36 L 30 36 L 27 39 L 23 38 L 20 40 L 17 38 L 14 39 L 12 36 L 8 34 L 8 30 L 5 28 L 6 24 L 5 20 L 8 18 L 8 14 L 12 13 L 14 9 L 18 10 Z&quot; fill=&quot;#FEF3C7&quot;/&gt;&lt;/svg&gt;&lt;/td&gt;&lt;td style=&quot;vertical-align:middle; text-align:left; padding-left:6px;&quot;&gt;&lt;b style=&quot;font-size:14.5px; color:#78350F;&quot;&gt;Batch Materialization&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px; color:#B45309; font-weight:600;&quot;&gt;feast materialize&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px; color:#92400E;&quot;&gt;Offline → Online&lt;br&gt;(on schedule)&lt;/font&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEF3C7;strokeColor=#FCD34D;strokeWidth=1.5;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="560" y="385" width="190" height="120" as="geometry" />
