        <!-- Redis Online Store (Focal Hero Component) -->
        <mxCell id="box_redis" value="&lt;div style=&quot;text-align:center; width:100%;&quot;&gt;&lt;svg width=&quot;52&quot; height=&quot;46&quot; viewBox=&quot;0 0 56 50&quot; fill=&quot;none&quot; stroke=&quot;#B91C1C&quot; stroke-width=&quot;2.4&quot;&gt;&lt;polygon points=&quot;28,4 48,14 28,24 8,14&quot; fill=&quot;#DC2626&quot; stroke=&quot;#B91C1C&quot;/&gt;&lt;polygon points=&quot;28,15 48,25 28,35 8,25&quot; fill=&quot;#DC2626&quot; stroke=&quot;#B91C1C&quot;/&gt;&lt;polygon points=&quot;28,26 48,36 28,46 8,36&quot; fill=&quot;#DC2626&quot; stroke=&quot;#B91C1C&quot;/&gt;&lt;/svg&gt;&lt;br&gt;&lt;b style=&quot;font-size:17px; color:#991B1B;&quot;&gt;Redis Online Store&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size:13.5px; color:#DC2626;&quot;&gt;redis:6379&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11.5px; color:#475569; line-height:1.4;&quot;&gt;Key-Value Cache&lt;br&gt;Latest feature values&lt;br&gt;Fast lookups&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FEE2E2;strokeColor=#FCA5A5;strokeWidth=1.5;align=center;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="845" y="325" width="200" height="210" as="geometry" />
        </mxCell>

        <!-- 5. ANIMATED CONNECTORS & FLOW ARROWS (flowAnimation=1) -->
        <!-- Top: Feature Repository -> Feature Registry -->
        <mxCell id="edge_repo" value="&lt;b&gt;feast apply&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;(write definitions)&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#64748B;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontColor=#0F172A;align=left;flowAnimation=1;" edge="1" parent="1" source="box_repo" target="box_registry">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="615" y="115" as="sourcePoint" />
            <mxPoint x="615" y="215" as="targetPoint" />
            <Array as="points">
              <mxPoint x="615" y="115" />
              <mxPoint x="615" y="215" />
            </Array>
            <mxPoint x="10" y="-5" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- ML Application -> Feast Server (POST :6566) -->
        <mxCell id="edge_ml" value="&lt;b style=&quot;color:#7C3AED; font-size:11px;&quot;&gt;POST&lt;br&gt;:6566&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=1;dashPattern=6 4;fontColor=#7C3AED;align=center;flowAnimation=1;" edge="1" parent="1" source="card_ml_app" target="box_server">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-15" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Live Feature Events -> Feast Server (Streaming Push) -->
        <mxCell id="edge_events" value="&lt;b style=&quot;color:#059669; font-size:11px;&quot;&gt;&lt;i&gt;feast push&lt;br&gt;(streaming)&lt;/i&gt;&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#059669;strokeWidth=2;dashed=1;dashPattern=6 4;fontColor=#059669;align=right;flowAnimation=1;" edge="1" parent="1" source="card_events" target="box_server">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="280" y="415" />
              <mxPoint x="280" y="295" />
            </Array>
            <mxPoint x="-10" y="15" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Web Browser -> Feast Web UI -->
        <mxCell id="edge_browser" value="&lt;b style=&quot;color:#7C3AED; font-size:11px;&quot;&gt;Explore catalog&lt;br&gt;:8888&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#7C3AED;strokeWidth=2;dashed=1;dashPattern=6 4;fontColor=#7C3AED;align=center;flowAnimation=1;" edge="1" parent="1" source="card_browser" target="box_ui">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-15" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Feast Server <-> Feature Registry (Bidirectional load definitions) -->
        <mxCell id="edge_server_reg" value="&lt;font style=&quot;font-size:10px; color:#475569;&quot;&gt;Load feature&lt;br&gt;definitions&lt;br&gt;(read/write)&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=classic;endArrow=classic;strokeColor=#0284C7;strokeWidth=1.5;dashed=1;dashPattern=6 4;align=center;flowAnimation=1;" edge="1" parent="1" source="box_server" target="box_registry">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-20" as="offset" />
          </mxGeometry>
