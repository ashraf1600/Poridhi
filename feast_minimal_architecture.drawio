<mxfile host="app.diagrams.net">
  <diagram id="feast-minimal-arch" name="Feast Minimal Architecture">
    <mxGraphModel dx="1240" dy="680" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="680" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Docker Environment Outer Container -->
        <mxCell id="docker_env" value="&lt;b style=&quot;font-size: 18px; font-family: -apple-system, BlinkMacSystemFont, Segoe UI, Roboto;&quot;&gt;Docker Environment&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#EDF1F3;strokeColor=#D5DEE5;strokeWidth=2;verticalAlign=top;spacingTop=20;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="440" y="35" width="760" height="610" as="geometry" />
        </mxCell>

        <!-- External Client: Client / ML Model -->
        <mxCell id="client_model" value="&lt;b style=&quot;font-size: 15px; font-family: -apple-system, BlinkMacSystemFont, Segoe UI, Roboto;&quot;&gt;Client / ML Model&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#E2CCF7;strokeColor=#D8B4FE;strokeWidth=1.5;fontColor=#111827;align=center;" vertex="1" parent="1">
          <mxGeometry x="45" y="95" width="195" height="135" as="geometry" />
        </mxCell>

        <!-- External Client: Web Browser -->
        <mxCell id="web_browser" value="&lt;b style=&quot;font-size: 15px; font-family: -apple-system, BlinkMacSystemFont, Segoe UI, Roboto;&quot;&gt;Web Browser&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#E2CCF7;strokeColor=#D8B4FE;strokeWidth=1.5;fontColor=#111827;align=center;" vertex="1" parent="1">
          <mxGeometry x="45" y="465" width="195" height="135" as="geometry" />
        </mxCell>

        <!-- Service 1: Feast Server -->
        <mxCell id="feast_server" value="&lt;b style=&quot;font-size: 15px; font-family: -apple-system, BlinkMacSystemFont, Segoe UI, Roboto;&quot;&gt;Feast Server&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;(Port 6566)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#C0D8FA;strokeColor=#93C5FD;strokeWidth=1.5;fontColor=#111827;align=center;" vertex="1" parent="1">
          <mxGeometry x="705" y="95" width="230" height="135" as="geometry" />
        </mxCell>

        <!-- Service 2: Feast UI -->
        <mxCell id="feast_ui" value="&lt;b style=&quot;font-size: 15px; font-family: -apple-system, BlinkMacSystemFont, Segoe UI, Roboto;&quot;&gt;Feast UI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;(Port 8888)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#C0D8FA;strokeColor=#93C5FD;strokeWidth=1.5;fontColor=#111827;align=center;" vertex="1" parent="1">
          <mxGeometry x="705" y="465" width="230" height="135" as="geometry" />
        </mxCell>

        <!-- Store 1: Parquet Offline Store -->
        <mxCell id="parquet_store" value="&lt;b style=&quot;font-size: 15px; font-family: -apple-system, BlinkMacSystemFont, Segoe UI, Roboto;&quot;&gt;Parquet Offline Store&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;(driver_stats.parquet)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#E2CCF7;strokeColor=#D8B4FE;strokeWidth=1.5;fontColor=#111827;align=center;" vertex="1" parent="1">
          <mxGeometry x="475" y="262" width="225" height="135" as="geometry" />
        </mxCell>

        <!-- Store 2: SQLite Online Store -->
        <mxCell id="sqlite_store" value="&lt;b style=&quot;font-size: 15px; font-family: -apple-system, BlinkMacSystemFont, Segoe UI, Roboto;&quot;&gt;SQLite Online Store&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;(online_store.db)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#E2CCF7;strokeColor=#D8B4FE;strokeWidth=1.5;fontColor=#111827;align=center;" vertex="1" parent="1">
          <mxGeometry x="940" y="262" width="225" height="135" as="geometry" />
        </mxCell>

        <!-- Schema Registry Central Element -->
        <mxCell id="schema_registry" value="&lt;b style=&quot;font-size: 14px; font-family: -apple-system, BlinkMacSystemFont, Segoe UI, Roboto;&quot;&gt;Schema Registry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12.5px; color: #334155;&quot;&gt;(registry.db)&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="720" y="348" width="200" height="40" as="geometry" />
        </mxCell>

        <!-- Vertical Metadata Connection Line: Feast Server to Feast UI -->
        <mxCell id="meta_line_1" value="" style="endArrow=none;html=1;strokeColor=#CBD5E1;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820" y="230" as="sourcePoint" />
            <mxPoint x="820" y="255" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="meta_line_2" value="" style="endArrow=none;html=1;strokeColor=#CBD5E1;strokeWidth=1.5;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820" y="388" as="sourcePoint" />
            <mxPoint x="820" y="465" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- Flow 1: Client -> Feast Server (HTTP Request) -->
        <mxCell id="flow_client" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;HTTP Request&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1E293B;strokeWidth=2;dashed=1;dashPattern=6 5;fontColor=#1E293B;labelBackgroundColor=none;align=center;" edge="1" parent="1" source="client_model" target="feast_server">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Flow 2: Browser -> Feast UI (Catalog View) -->
        <mxCell id="flow_browser" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Catalog View&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1E293B;strokeWidth=2;dashed=1;dashPattern=6 5;fontColor=#1E293B;labelBackgroundColor=none;align=center;" edge="1" parent="1" source="web_browser" target="feast_ui">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Flow 3: Parquet -> SQLite (Materialization) -->
        <mxCell id="flow_mat" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Materialization&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1E293B;strokeWidth=2;dashed=1;dashPattern=6 5;fontColor=#1E293B;labelBackgroundColor=none;align=center;" edge="1" parent="1" source="parquet_store" target="sqlite_store">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-15" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Flow 4: Feast Server -> SQLite (Fetch Features) -->
        <mxCell id="flow_fetch" value="&lt;b style=&quot;font-size: 12.5px;&quot;&gt;Fetch&lt;br&gt;Features&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1E293B;strokeWidth=2;dashed=1;dashPattern=6 5;fontColor=#1E293B;labelBackgroundColor=none;align=left;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="935" y="162" as="sourcePoint" />
            <mxPoint x="1052" y="262" as="targetPoint" />
            <Array as="points">
              <mxPoint x="1052" y="162" />
            </Array>
            <mxPoint x="15" y="-15" as="offset" />
          </mxGeometry>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
